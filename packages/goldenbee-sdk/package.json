{
  "name": "@goldenbee/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, platform-neutral TypeScript client for the Goldenbee Gateway HTTP, SSE, and WebSocket APIs.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2"
  }
}
