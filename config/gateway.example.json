{
  "listen": "127.0.0.1:8080",
  "data_dir": "gateway-state",
  "registry": "./gateway-registry.json",
  "lease_ttl_ms": 30000,
  "max_streams": 256,
  "socket": {
    "max_frame_bytes": 65536,
    "subscriber_queue": 64,
    "max_subscriptions": 4,
    "idle_timeout_ms": 60000,
    "heartbeat_ms": 20000,
    "send_timeout_ms": 5000,
    "ticket_ttl_ms": 30000
  },
  "callers": [
    {
      "token": "replace-with-a-caller-token",
      "id": "local-operator",
      "namespace": "local",
      "scopes": [
        "task:submit",
        "task:read",
        "task:cancel",
        "artifact:read"
      ],
      "workers": [
        "general-a"
      ]
    },
    {
      "token": "replace-with-an-admin-token",
      "id": "local-admin",
      "namespace": "local",
      "scopes": [
        "admin",
        "task:read"
      ]
    }
  ],
  "host_id": "local",
  "instances_root": "/var/lib/goldenbee/instances",
  "packages_root": "/var/lib/goldenbee/packages",
  "trust_policy": "/etc/goldenbee/trust.json",
  "allowed_package_sources": [
    "/srv/goldenbee/releases"
  ],
  "operations": [
    "provision",
    "inspect",
    "upgrade",
    "rollback",
    "start",
    "stop",
    "restart"
  ],
  "allowed_grants": [
    "task:submit",
    "task:read",
    "task:cancel",
    "session:write",
    "profile:read",
    "profile:write"
  ],
  "allowed_profile_grants": [
    "task:submit",
    "task:read"
  ],
  "allowed_config_roots": [
    "/etc/goldenbee/workers"
  ],
  "allowed_workspace_roots": [
    "/srv/goldenbee/workspaces"
  ],
  "allowed_secret_prefixes": [
    "secret://"
  ],
  "allow_remote_listener": false
}
