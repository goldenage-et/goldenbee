# Gateway address used by the Vite development proxy for same-origin /v1 calls.
# This value is server-side only and is never exposed to the browser.
GOLDENBEE_GATEWAY_URL=http://127.0.0.1:8080

# Optional browser-visible default for the connection form. Leave empty to
# default to the current origin and use the Vite proxy.
VITE_GATEWAY_URL=
