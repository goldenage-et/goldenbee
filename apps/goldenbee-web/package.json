{
  "name": "goldenbee-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @goldenbee/sdk build && vite",
    "build": "bun run --filter @goldenbee/sdk build && tsc -b && vite build && bun ../../scripts/check-static-build.ts",
    "typecheck": "bun run --filter @goldenbee/sdk build && tsc -b --pretty false",
    "lint": "oxlint",
    "test": "bun run --filter @goldenbee/sdk build && bunx vitest run",
    "test:watch": "bunx vitest",
    "e2e": "bun run --filter @goldenbee/sdk build && bunx playwright test",
    "e2e:install": "bunx playwright install --with-deps chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@goldenbee/sdk": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "recharts": "3.8.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
