{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenbee.local/schema/worker-v1.json",
  "title": "Goldenbee Worker protocol v1",
  "description": "Harness management routes exposed by every Worker Package alongside native ADK serving.",
  "definitions": {
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable", "recovery"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "recovery": { "type": "string" },
        "details": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_duration_ms": { "type": "integer", "minimum": 0 },
        "max_model_calls": { "type": "integer", "minimum": 0 },
        "max_tool_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "contextCompaction": {
      "type": "object",
      "required": ["strategy", "context_budget", "preserve_recent", "max_retries"],
      "properties": {
        "strategy": { "type": "string", "enum": ["truncation"] },
        "context_budget": { "type": "integer", "minimum": 0 },
        "preserve_recent": { "type": "integer", "minimum": 0 },
        "max_retries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "profileRevision": {
      "type": "object",
      "required": ["revision", "instruction", "model", "created_at"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "instruction": { "type": "string", "maxLength": 100000 },
        "model": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "grants": { "type": "array", "items": { "type": "string" } },
        "restrictions": { "type": "array", "items": { "type": "string" } },
        "composition": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "mcp": { "type": "array", "items": { "type": "string" } },
        "workflow": { "type": "string" },
        "limits": { "$ref": "#/definitions/limits" },
        "compaction": { "$ref": "#/definitions/contextCompaction" },
        "secret_refs": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["name", "active_revision", "revisions"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "active_revision": { "type": "integer", "minimum": 0 },
        "revisions": { "type": "array", "items": { "$ref": "#/definitions/profileRevision" } }
      },
      "additionalProperties": false
    },
    "createProfileRequest": {
      "type": "object",
      "required": ["name", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "revision": { "$ref": "#/definitions/profileRevision" }
      },
      "additionalProperties": false
    },
    "reviseProfileRequest": {
      "type": "object",
      "required": ["expected_revision", "revision"],
      "properties": {
        "expected_revision": { "type": "integer", "minimum": 1 },
        "revision": { "$ref": "#/definitions/profileRevision" }
      },
      "additionalProperties": false
    },
    "profileVersionRequest": {
      "type": "object",
      "properties": {
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "deletedProfile": {
      "type": "object",
      "required": ["deleted"],
      "properties": {
        "deleted": { "type": "string" }
      },
      "additionalProperties": false
    },
    "submitTaskRequest": {
      "type": "object",
      "required": ["agent", "session_id", "input", "idempotency_key"],
      "properties": {
        "namespace": { "type": "string" },
        "agent": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
        "profile": { "type": "string" },
        "team": { "type": "string" },
        "worker": { "type": "string" },
        "limits": { "$ref": "#/definitions/limits" }
      }
    },
    "submitTaskResponse": {
      "type": "object",
      "required": ["task_id", "state", "replayed", "unknown_submission", "agent", "profile"],
      "properties": {
        "task_id": { "type": "string" },
        "state": {
          "enum": ["accepted", "queued", "running", "cancelling", "succeeded", "failed", "cancelled", "unknown", "recovering", "input_required", "paused"]
        },
        "replayed": { "type": "boolean" },
        "unknown_submission": { "type": "boolean" },
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "team_version": { "type": "integer" }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "namespace", "caller", "agent", "session_id", "state", "attempt"],
      "properties": {
        "id": { "type": "string" },
        "namespace": { "type": "string" },
        "caller": { "type": "string" },
        "agent": { "type": "string" },
        "session_id": { "type": "string" },
        "state": { "type": "string" },
        "attempt": { "type": "integer" },
        "profile_revision": { "type": "integer", "minimum": 1 },
        "asset_revision": { "type": "integer", "minimum": 1 },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "traffic": { "type": "string", "enum": ["local", "product"] },
        "resolved_model": {
          "type": ["object", "null"],
          "required": ["provider", "adapter", "model", "local", "residency", "profile_revision"],
          "properties": {
            "provider": { "type": "string" },
            "adapter": { "type": "string" },
            "model": { "type": "string" },
            "local": { "type": "boolean" },
            "residency": { "type": "string" },
            "endpoint": { "type": ["string", "null"] },
            "credential": { "type": ["string", "null"] },
            "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
            "reasoning": {
              "type": ["string", "null"],
              "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", null]
            },
            "profile_revision": { "type": "integer", "minimum": 1 }
          }
        },
        "output": { "type": ["string", "null"] },
        "error": { "$ref": "#/definitions/error" },
        "uncertainty": { "type": ["string", "null"] },
        "native_invocation_id": { "type": ["string", "null"] },
        "team": { "type": "string" },
        "team_version": { "type": "integer", "minimum": 0 },
        "team_roster": { "type": ["object", "null"] },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "delegation_path": { "type": "array", "items": { "type": "string" } },
        "authority_expires_at": { "type": ["integer", "null"] },
        "usage": { "type": "object" }
      }
    },
    "streamEvent": {
      "type": "object",
      "required": ["event_id", "source", "incarnation", "stream_id", "seq", "schema_version", "kind", "durable"],
      "properties": {
        "event_id": { "type": "string" },
        "source": { "type": "string" },
        "incarnation": { "type": "string" },
        "stream_id": { "type": "string" },
        "seq": { "type": "integer", "minimum": 1 },
        "schema_version": { "type": "integer" },
        "kind": { "type": "string" },
        "durable": { "type": "boolean" },
        "payload": {},
        "trace_id": { "type": ["string", "null"] },
        "at": { "type": "integer" }
      }
    },
    "streamPage": {
      "type": "object",
      "required": ["stream_id", "events", "next_seq", "oldest_seq", "cursor_expired"],
      "properties": {
        "stream_id": { "type": "string" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/streamEvent" }
        },
        "next_seq": { "type": "integer" },
        "oldest_seq": { "type": "integer" },
        "cursor_expired": { "type": "boolean" }
      }
    },
    "planCriterionEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "output_contains" },
            "text": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "artifact_digest" },
            "artifact_id": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "createPlanRequest": {
      "type": "object",
      "required": ["parent_task_id", "objective", "criteria", "children"],
      "properties": {
        "parent_task_id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string" },
        "limits": { "$ref": "#/definitions/limits" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "child", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "child": { "type": "string", "minLength": 1 },
              "evidence": { "$ref": "#/definitions/planCriterionEvidence" }
            }
          }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["id", "capability", "objective"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "member": { "type": "string" },
              "peer": { "type": "string" },
              "capability": { "type": "string", "minLength": 1 },
              "objective": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "limits": { "$ref": "#/definitions/limits" }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "task_id", "native_invocation_id", "attempt", "version", "namespace", "owner", "name", "content_type", "size", "digest", "finalized", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "task_id": { "type": "string" },
        "native_invocation_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "version": { "type": "integer", "minimum": 1 },
        "namespace": { "type": "string" },
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "content_type": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "finalized": { "type": "boolean" },
        "created_at": { "type": "integer" }
      }
    },
    "artifactGrant": {
      "type": "object",
      "required": ["artifact_id", "grant", "expires_at"],
      "properties": {
        "artifact_id": { "type": "string" },
        "grant": { "type": "string" },
        "expires_at": { "type": "integer" }
      }
    },
    "retainedObligation": {
      "type": "object",
      "required": ["class", "id", "reason"],
      "properties": {
        "class": { "type": "string" },
        "id": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "blockedStep": {
      "type": "object",
      "required": ["store", "code", "message"],
      "properties": {
        "store": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "lifecycleReport": {
      "type": "object",
      "required": ["job_id", "resumed", "completed", "removed", "retained", "blocked", "cursor_expiry"],
      "properties": {
        "job_id": { "type": "string" },
        "resumed": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "removed": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "retained": {
          "type": "array",
          "items": { "$ref": "#/definitions/retainedObligation" }
        },
        "blocked": {
          "type": "array",
          "items": { "$ref": "#/definitions/blockedStep" }
        },
        "cursor_expiry": { "type": "integer", "minimum": 0 }
      }
    },
    "commandArgument": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" }
      },
      "additionalProperties": false
    },
    "commandDescriptor": {
      "type": "object",
      "required": ["name", "description", "kind", "source"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "type": "string", "enum": ["neutral", "worker"] },
        "source": { "type": "string", "enum": ["runtime", "assets"] },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/commandArgument" }
        },
        "allowed_tools": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "commandRequest": {
      "type": "object",
      "properties": {
        "input": { "type": "string" },
        "arguments": { "type": "object", "additionalProperties": { "type": "string" } },
        "session_id": { "type": "string" },
        "idempotency_key": { "type": "string" },
        "agent": { "type": "string" },
        "limits": { "$ref": "#/definitions/limits" }
      },
      "additionalProperties": false
    },
    "commandResponse": {
      "type": "object",
      "required": ["command", "kind"],
      "properties": {
        "command": { "type": "string" },
        "kind": { "type": "string", "enum": ["neutral", "worker"] },
        "result": {},
        "task": { "type": "object" }
      },
      "additionalProperties": false
    },
    "runSource": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["text", "stdin", "file", "image"] },
        "text": { "type": "string", "maxLength": 1000000 },
        "path": { "type": "string" },
        "media_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runFile": {
      "type": "object",
      "required": ["name", "media_type", "bytes", "digest"],
      "properties": {
        "name": { "type": "string" },
        "media_type": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runImage": {
      "type": "object",
      "required": ["media_type", "data"],
      "properties": {
        "media_type": { "type": "string", "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"] },
        "data": { "type": "string", "maxLength": 699052 },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runInput": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 1000000 },
        "files": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/runFile" } },
        "images": { "type": "array", "maxItems": 4, "items": { "$ref": "#/definitions/runImage" } }
      },
      "additionalProperties": false
    },
    "runRequest": {
      "type": "object",
      "required": ["input"],
      "properties": {
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "session_id": { "type": "string" },
        "continue": { "type": "boolean" },
        "resume_session": { "type": "string" },
        "input": { "$ref": "#/definitions/runInput" },
        "limits": { "$ref": "#/definitions/limits" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
        "wait_ms": { "type": "integer", "minimum": 0, "maximum": 600000 }
      },
      "additionalProperties": false
    },
    "runResult": {
      "type": "object",
      "required": ["schema_version", "task_id", "session_id", "agent", "profile", "profile_revision", "asset_revision", "state", "exit_code"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "task_id": { "type": "string" },
        "session_id": { "type": "string" },
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "profile_revision": { "type": "integer", "minimum": 0 },
        "asset_revision": { "type": "integer", "minimum": 0 },
        "trace_id": { "type": "string" },
        "state": { "type": "string" },
        "resolved_model": {},
        "output": { "type": "string" },
        "error": { "$ref": "#/definitions/error" },
        "uncertainty": { "type": "string" },
        "usage": { "type": "object" },
        "native_invocation_id": { "type": "string" },
        "evidence": {},
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 7 }
      },
      "additionalProperties": false
    },
    "jsonlItem": {
      "type": "object",
      "required": ["item_type"],
      "properties": {
        "item_type": { "type": "string", "enum": ["agent_message", "reasoning", "tool_call", "approval", "diff"] },
        "id": { "type": "string" },
        "text": { "type": "string" },
        "name": { "type": "string" },
        "server": { "type": "string" },
        "agent": { "type": "string" },
        "ok": { "type": "boolean" },
        "error_code": { "type": "string" },
        "operation": { "type": "string" },
        "target": { "type": "string" },
        "risk": { "type": "string" },
        "decision": { "type": "string" },
        "status": { "type": "string" },
        "diff": { "type": "object" }
      },
      "additionalProperties": false
    },
    "jsonlFrame": {
      "type": "object",
      "required": ["type", "task_id"],
      "properties": {
        "type": { "type": "string", "enum": ["task_started", "turn_started", "item_started", "item_updated", "item_completed", "task_completed"] },
        "schema_version": { "type": "integer", "minimum": 1 },
        "task_id": { "type": "string" },
        "session_id": { "type": "string" },
        "agent": { "type": "string" },
        "profile": { "type": "string" },
        "profile_revision": { "type": "integer", "minimum": 0 },
        "asset_revision": { "type": "integer", "minimum": 0 },
        "trace_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 0 },
        "seq": { "type": "integer", "minimum": 0 },
        "at": { "type": "integer" },
        "resolved_model": {},
        "item": { "$ref": "#/definitions/jsonlItem" },
        "state": { "type": "string" },
        "output": { "type": "string" },
        "error": { "$ref": "#/definitions/error" },
        "uncertainty": { "type": "string" },
        "usage": { "type": "object" },
        "native_invocation_id": { "type": "string" },
        "evidence": {},
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 7 }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["package", "version", "protocol", "runtime", "adk", "instance", "durable_tasks", "a2a_task_storage", "a2a_durable", "artifact_storage", "artifact_transfer", "artifact_max_bytes", "capabilities"],
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string" },
        "protocol": { "type": "string" },
        "runtime": { "type": "string" },
        "adk": { "type": "string" },
        "instance": { "type": "string" },
        "durable_tasks": { "type": "boolean" },
        "a2a_task_storage": { "type": "string" },
        "a2a_durable": { "type": "boolean" },
        "artifact_storage": { "type": "string" },
        "artifact_transfer": { "type": "string" },
        "artifact_max_bytes": { "type": "integer", "minimum": 1 },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/definitions/commandDescriptor" }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "description"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string" },
              "description": { "type": "string" },
              "permissions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
