# Local development environment.
# Copy to .env and fill in values. Never commit the real file.

# Optional remote provider for direct Worker runs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_KEY=

# Optional shared secret for Gateway/Worker delegation.
# GOLDENBEE_DELEGATION_SECRET=

# Optional Worker data and sandbox locations.
# GOLDENBEE_DATA_DIR=
# GOLDENBEE_SANDBOX_DIR=
