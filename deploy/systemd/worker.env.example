# Copy to /etc/goldenbee/workers/<instance>.env, then set owner root:root and
# mode 0600. This example uses the general-a instance; replace every path and
# credential. Never commit real secret values.
#
# Shared with the Gateway. Workers verify Gateway-issued delegation tokens.
GOLDENBEE_DELEGATION_SECRET=replace-with-a-long-random-shared-secret
#
# Keep the sandbox workspace inside the unit's ReadWritePaths.
GOLDENBEE_DATA_DIR=/var/lib/goldenbee/workers/general-a
GOLDENBEE_SANDBOX_DIR=/var/lib/goldenbee/workers/general-a/workspace
#
# Provider credentials are optional when the configured model does not call a
# remote provider. Prefer this root-owned environment file over the TOML file.
# OPENROUTER_API_KEY=replace-with-provider-key
# OPENROUTER_MODEL_KEY=replace-with-provider-model-key
